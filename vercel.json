{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.seasiderestaurantbar.com" }],
      "destination": "https://seasiderestaurantbar.com/:path",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },

    { "source": "/menu", "destination": "/#menu", "permanent": true },
    { "source": "/menu/", "destination": "/#menu", "permanent": true },
    { "source": "/breakfast-menu", "destination": "/#menu", "permanent": true },
    { "source": "/breakfast-menu/", "destination": "/#menu", "permanent": true },
    { "source": "/lunch-dinner-menu", "destination": "/#menu", "permanent": true },
    { "source": "/lunch-dinner-menu/", "destination": "/#menu", "permanent": true },
    { "source": "/kids-menu", "destination": "/#menu", "permanent": true },
    { "source": "/kids-menu/", "destination": "/#menu", "permanent": true },
    { "source": "/breakfast", "destination": "/#menu", "permanent": true },
    { "source": "/breakfast/", "destination": "/#menu", "permanent": true },
    { "source": "/shop", "destination": "/#menu", "permanent": true },
    { "source": "/shop/", "destination": "/#menu", "permanent": true },
    { "source": "/order-online", "destination": "/#menu", "permanent": true },
    { "source": "/order-online/", "destination": "/#menu", "permanent": true },
    { "source": "/restaurant-order", "destination": "/#menu", "permanent": true },
    { "source": "/restaurant-order/", "destination": "/#menu", "permanent": true },
    { "source": "/product/(.*)", "destination": "/#menu", "permanent": true },
    { "source": "/product-category/(.*)", "destination": "/#menu", "permanent": true },

    { "source": "/about-us", "destination": "/#about", "permanent": true },
    { "source": "/about-us/", "destination": "/#about", "permanent": true },
    { "source": "/faq", "destination": "/#faq", "permanent": true },
    { "source": "/faq/", "destination": "/#faq", "permanent": true },

    { "source": "/cart", "destination": "/", "permanent": true },
    { "source": "/cart/", "destination": "/", "permanent": true },
    { "source": "/cart-2", "destination": "/", "permanent": true },
    { "source": "/cart-2/", "destination": "/", "permanent": true },
    { "source": "/my-account", "destination": "/", "permanent": true },
    { "source": "/my-account/", "destination": "/", "permanent": true },
    { "source": "/career", "destination": "/", "permanent": true },
    { "source": "/career/", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
